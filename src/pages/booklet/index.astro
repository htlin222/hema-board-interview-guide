---
import { marked } from 'marked';
import { layoutSheet } from '../../lib/booklet';
import { sheets, doseSheets } from '../../lib/booklet-data';
import '../../styles/print.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const render = (s: string) => marked.parse(s, { async: false }) as string;
const total = sheets.length + doseSheets.length;
---

<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>A4 手冊｜血液科口試走向指南</title>
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
	</head>
	<body>
		<div class="toolbar">
			<button onclick="window.print()">列印 / 存成 PDF</button>
			<a href={`${base}/`}>回網站</a>
			<a href={`${base}/handout/`}>每章一頁速查</a>
			<a href={`${base}/booklet-a5/`}>A5 平板版</a>
			<span>{total} 張 A4：第一性原理 × MECE 分岔 × 速記表 × 參考劑量</span>
		</div>

		{
			sheets.map((s, i) => (
				<div class="sheet" id={s.id} data-page={i + 1}>
					<header>
						<h1>{s.title}</h1>
						<div class="kicker">{s.kicker || `${String(i + 1).padStart(2, '0')}`} · 血液科口試走向指南</div>
					</header>
					<div class="content">
						<div class="inner">
							<Fragment set:html={layoutSheet(s.body, render)} />
						</div>
					</div>
					<footer>
						<span>
							htlin222.github.io/hema-board-interview-guide
							{s.site && ` · 完整內容：/topics/${s.site}/`}
						</span>
						<span>
							{i + 1} / {total} · 去名化整理，非官方資料
						</span>
					</footer>
				</div>
			))
		}

		{
			doseSheets.map((d, j) => (
				<div class="sheet" id={d.id} data-page={sheets.length + j + 1}>
					<header>
						<h1>{d.title}</h1>
						<div class="kicker">{d.kicker} · 血液科口試走向指南</div>
					</header>
					<div class="content">
						<div class="inner">
						<div class="fp">
							<b>怎麼用</b>
							成人常規參考劑量，答題時講得出「數量級、途徑、頻率、要監測什麼」即可；實際處方以仿單、健保規定與最新指引為準，特殊族群（腎功能、孕婦、兒童）另行查核。
						</div>
						{d.groups.map((g) => (
							<>
								<h2>{g.title}</h2>
								<Fragment set:html={render(g.body)} />
							</>
						))}
						</div>
					</div>
					<footer>
						<span>htlin222.github.io/hema-board-interview-guide · 主題頁「參考劑量」段落與本表同源</span>
						<span>
							{sheets.length + j + 1} / {total} · 參考值，非處方依據
						</span>
					</footer>
				</div>
			))
		}
	</body>
</html>
