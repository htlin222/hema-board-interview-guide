---
import { marked } from 'marked';
import { layoutSheet } from '../../lib/booklet';
import { sheets, tableSheets } from '../../lib/booklet-data';
import '../../styles/print.css';
import '../../styles/print-a5.css';

// 平板大字版（網址沿用 booklet-a5）：跟 /booklet/（A4）讀同一份資料、同一套樣式。
// 紙張同為 A4 橫式，但每頁只放約半張內容、字放大約 1.5 倍，每章自動分頁。
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const render = (s: string) => marked.parse(s, { async: false }) as string;
const total = sheets.length + tableSheets.length;
---

<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>平板大字版手冊｜血液科口試走向指南</title>
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
	</head>
	<body>
		<div class="toolbar">
			<button onclick="window.print()">列印 / 存成 PDF</button>
			<a href={`${base}/`}>回網站</a>
			<a href={`${base}/booklet/`}>A4 版</a>
			<span>{total} 章，每章分成約兩頁、字約為 A4 版 1.5 倍；內容與 A4 版同源</span>
		</div>

		{
			sheets.map((s, i) => (
				<article class="chapter" id={s.id} data-chapter={i + 1}>
					<div class="flow">
						<header>
							<h1>{s.title}</h1>
							<div class="kicker">{s.kicker || `${String(i + 1).padStart(2, '0')}`}</div>
						</header>
						<Fragment set:html={layoutSheet(s.body, render)} />
					</div>
				</article>
			))
		}

		{
			tableSheets.map((d, j) => (
				<article class="chapter" id={d.id} data-chapter={sheets.length + j + 1}>
					<div class="flow">
						<header>
							<h1>{d.title}</h1>
							<div class="kicker">{d.kicker}</div>
						</header>
						{d.note && (
							<div class="fp">
								<b>怎麼用</b>
								{d.note}
							</div>
						)}
						{d.groups.map((g) => (
							<>
								<h2>{g.title}</h2>
								<Fragment set:html={render(g.body)} />
							</>
						))}
					</div>
				</article>
			))
		}

		<main id="pages"></main>

		<script is:inline>
			// 把每章（.chapter 裡的原始內容）切成一張張橫式 A4 頁（.pg）：螢幕上看到的就是印出來的頁。
			// - 依區塊逐一放進頁面，放不下就換頁；標題不留在頁尾（跟著下一塊走）。
			// - 表格從列與列之間切開、下一頁重複表頭；條列從項目之間切開。
			// - 某章最後一頁只剩一小截（<45%）時，試著把整章字級調小一檔（93%、87%）收回整數頁。
			//   只用這三檔：Chrome 會為每一種字級各嵌一份字型，檔位多了 PDF 會暴增。
			// 完成後在 <body> 標上 data-paged，建置腳本等這個訊號再印 PDF。
			(function () {
				var STEPS = [1, 0.93, 0.87];
				var FOOT_LEFT = '血液科口試走向指南 · 平板大字版 · 去名化整理，非官方資料';
				var root = document.getElementById('pages');

				function blocks(node) {
					var out = [];
					for (var i = 0; i < node.children.length; i++) {
						var el = node.children[i];
						if (el.tagName === 'SECTION' || (el.tagName === 'DIV' && el.classList.contains('pair'))) {
							out = out.concat(blocks(el));
						} else out.push(el);
					}
					return out;
				}
				function over(body) {
					return body.scrollHeight > body.clientHeight + 1;
				}
				function isHeading(el) {
					return el && /^H[1-6]$/.test(el.tagName);
				}

				function paginate(chapter, s) {
					var title = chapter.querySelector('h1').textContent;
					var pages = [];
					var body;
					function newPage() {
						var pg = document.createElement('section');
						pg.className = 'pg';
						pg.style.setProperty('--s', String(s));
						if (pages.length) {
							var cont = document.createElement('div');
							cont.className = 'pg-cont';
							cont.textContent = title + '（續）';
							pg.appendChild(cont);
						}
						body = document.createElement('div');
						body.className = 'pg-body';
						pg.appendChild(body);
						var foot = document.createElement('div');
						foot.className = 'pg-foot';
						foot.innerHTML = '<span></span><span></span>';
						pg.appendChild(foot);
						root.appendChild(pg);
						pages.push(pg);
					}
					// 換頁時把頁尾孤零零的標題帶到新頁
					function breakPage() {
						var carry = [];
						while (isHeading(body.lastElementChild) && body.children.length > 1) carry.unshift(body.removeChild(body.lastElementChild));
						newPage();
						carry.forEach(function (el) { body.appendChild(el); });
					}
					function splitInto(el, items, makeShell, holder) {
						// 表格／條列：一列一列放，放不下就換頁、重建外殼
						var shell = makeShell();
						body.appendChild(shell);
						for (var i = 0; i < items.length; i++) {
							var it = items[i].cloneNode(true);
							holder(shell).appendChild(it);
							if (over(body)) {
								holder(shell).removeChild(it);
								if (!holder(shell).children.length) body.removeChild(shell);
								breakPage();
								shell = makeShell();
								body.appendChild(shell);
								holder(shell).appendChild(it);
							}
						}
					}
					newPage();
					blocks(chapter.querySelector('.flow')).forEach(function (el) {
						var c = el.cloneNode(true);
						body.appendChild(c);
						if (!over(body)) return;
						if (el.tagName === 'TABLE' && el.tBodies.length) {
							body.removeChild(c);
							splitInto(el, el.tBodies[0].rows, function () {
								var t = el.cloneNode(false);
								if (el.tHead) t.appendChild(el.tHead.cloneNode(true));
								t.appendChild(document.createElement('tbody'));
								return t;
							}, function (t) { return t.tBodies[0]; });
						} else if ((el.tagName === 'UL' || el.tagName === 'OL') && el.children.length > 1) {
							body.removeChild(c);
							splitInto(el, el.children, function () { return el.cloneNode(false); }, function (l) { return l; });
						} else if (body.children.length > 1) {
							body.removeChild(c);
							breakPage();
							body.appendChild(c); // 單一區塊比一頁還高就只能放著，建置檢查會抓出來
						}
					});
					return pages;
				}

				function lastFill(pages) {
					var b = pages[pages.length - 1].querySelector('.pg-body');
					var last = b.lastElementChild;
					if (!last) return 0;
					return (last.getBoundingClientRect().bottom - b.getBoundingClientRect().top) / b.clientHeight;
				}

				function run() {
					root.innerHTML = '';
					document.querySelectorAll('.chapter').forEach(function (chapter) {
						var best = paginate(chapter, STEPS[0]);
						best[0].dataset.s = '1';
						if (best.length > 1 && lastFill(best) < 0.45) {
							for (var i = 1; i < STEPS.length; i++) {
								var mark = root.lastElementChild;
								var trial = paginate(chapter, STEPS[i]);
								if (trial.length < best.length) {
									best.forEach(function (p) { root.removeChild(p); });
									best = trial;
									best[0].dataset.s = String(STEPS[i]);
									break;
								}
								trial.forEach(function (p) { root.removeChild(p); });
							}
						}
						best[0].dataset.chapter = chapter.querySelector('h1').textContent;
					});
					var all = root.querySelectorAll('.pg');
					all.forEach(function (pg, i) {
						var spans = pg.querySelectorAll('.pg-foot span');
						spans[0].textContent = FOOT_LEFT;
						spans[1].textContent = i + 1 + ' / ' + all.length;
					});
					document.body.classList.add('paged');
					document.body.dataset.paged = String(all.length);
					fitWidth();
				}

				// 螢幕上把整頁縮放到視窗寬（平板上一頁剛好一個畫面寬）；列印不受影響
				function fitWidth() {
					var pageW = (297 * 96) / 25.4 + 16;
					document.documentElement.style.setProperty('--fitw', String(Math.min(1, window.innerWidth / pageW)));
				}
				window.addEventListener('resize', fitWidth);

				if (document.fonts && document.fonts.ready) document.fonts.ready.then(run);
				else window.addEventListener('load', run);
			})();
		</script>
	</body>
</html>
