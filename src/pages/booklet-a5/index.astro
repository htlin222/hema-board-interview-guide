---
import { marked } from 'marked';
import { layoutSheet } from '../../lib/booklet';
import { sheets, doseSheets } from '../../lib/booklet-data';
import '../../styles/print.css';
import '../../styles/print-a5.css';

// A5 平板版：跟 /booklet/（A4）讀同一份資料、同一套樣式，只是版面改成每章自動分頁、字放大。
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const render = (s: string) => marked.parse(s, { async: false }) as string;
const total = sheets.length + doseSheets.length;
---

<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>A5 平板版手冊｜血液科口試走向指南</title>
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
	</head>
	<body>
		<div class="toolbar">
			<button onclick="window.print()">列印 / 存成 PDF</button>
			<a href={`${base}/`}>回網站</a>
			<a href={`${base}/booklet/`}>A4 版</a>
			<span>{total} 章，每章從新的一頁開始；內容與 A4 版同源</span>
		</div>

		{
			sheets.map((s, i) => (
				<article class="chapter" id={s.id} data-chapter={i + 1}>
					<div class="flow">
						<header>
							<h1>{s.title}</h1>
							<div class="kicker">{s.kicker || `${String(i + 1).padStart(2, '0')}`}</div>
						</header>
						<Fragment set:html={layoutSheet(s.body, render)} />
					</div>
				</article>
			))
		}

		{
			doseSheets.map((d, j) => (
				<article class="chapter" id={d.id} data-chapter={sheets.length + j + 1}>
					<div class="flow">
					<header>
						<h1>{d.title}</h1>
						<div class="kicker">{d.kicker}</div>
					</header>
					<div class="fp">
						<b>怎麼用</b>
						成人常規參考劑量，答題時講得出「數量級、途徑、頻率、要監測什麼」即可；實際處方以仿單、健保規定與最新指引為準，特殊族群（腎功能、孕婦、兒童）另行查核。
					</div>
					{d.groups.map((g) => (
						<>
							<h2>{g.title}</h2>
							<Fragment set:html={render(g.body)} />
						</>
					))}
					</div>
				</article>
			))
		}

		<script is:inline>
			// 每章從新的一頁開始，內容自動往下流。某章如果只多出一小截（不到 45% 頁），
			// 就把那章的字級調小一檔（CSS 變數 --s）收回整數頁，避免最後一頁只有兩三行；最小 87%，多出很多就維持多一頁。
			// 螢幕上 .chapter 的 padding 跟列印的 @page 邊界相同（上 7、下 9、左右 8 mm），所以在這裡量的就是列印時的高度。
			(function () {
				var mm = 96 / 25.4;
				var pageH = (148 - 7 - 9) * mm * 0.93; // 0.93：表格列不拆頁會在頁尾留白，預留這個損耗
				// 只用三檔比例：Chrome 會為每一種字級各嵌一份字型，每章各算一個比例會讓 PDF 暴增數倍
				var STEPS = [1, 0.93, 0.87];
				function fit() {
					document.querySelectorAll('.chapter .flow').forEach(function (flow) {
						var chapter = flow.parentElement;
						flow.style.setProperty('--s', '1');
						var n = flow.getBoundingClientRect().height / pageH;
						var whole = Math.floor(n);
						chapter.dataset.pages = String(Math.ceil(n));
						if (whole < 1 || n === whole || n - whole > 0.45) return;
						var room = whole * pageH;
						for (var i = 1; i < STEPS.length; i++) {
							flow.style.setProperty('--s', String(STEPS[i]));
							if (flow.getBoundingClientRect().height <= room) {
								chapter.dataset.pages = String(whole);
								return;
							}
						}
						flow.style.setProperty('--s', '1'); // 最小一檔也收不回，就維持原大小、多一頁
					});
				}
				if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
				else window.addEventListener('load', fit);
			})();
		</script>
	</body>
</html>
