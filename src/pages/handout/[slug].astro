---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { extractHandout, stripIcons } from '../../lib/handout';
import '../../styles/print.css';

export async function getStaticPaths() {
	const docs = await getCollection('docs');
	return docs
		.filter((d) => d.id.startsWith('topics/') && !d.id.endsWith('exam-format-and-mindset'))
		.map((entry) => ({ params: { slug: entry.id.replace('topics/', '') }, props: { entry } }));
}

const { entry } = Astro.props;
const md: string = entry.body ?? '';
const { frameworks, tables, openers, pitfalls } = extractHandout(md);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const render = (s: string) => marked.parse(stripIcons(s), { async: false }) as string;
---

<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{entry.data.title}｜一頁速查</title>
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
	</head>
	<body>
		<div class="toolbar">
			<button onclick="window.print()">列印 / 存成 PDF</button>
			<a href={`${base}/topics/${Astro.params.slug}/`}>回完整內容</a>
			<a href={`${base}/handout/`}>所有速查表</a>
			<a href={`${base}/booklet/`}>A4 手冊</a>
			<span>橫式 A4 一頁，版面與手冊相同；擬答與影片不印，需要時回網站看</span>
		</div>

		<div class="sheet">
			<header>
				<h1>{entry.data.title}</h1>
				<div class="kicker">一頁速查 · 血液科口試走向指南</div>
			</header>
			<div class="content">
				<div class="inner">
					{
						frameworks.length > 0 && (
							<>
								<h2>推理架構</h2>
								<div class="two">
									{frameworks.map((f) => (
										<>
											<h3>{f.heading}</h3>
											<Fragment set:html={render(f.body)} />
										</>
									))}
								</div>
							</>
						)
					}
					{
						openers.length > 0 && (
							<>
								<h2>破題關鍵句</h2>
								<div class="openers two">
									<dl>
										{openers.map((o) => (
											<>
												{o.question && <dt>{o.question}</dt>}
												<dd>{o.line}</dd>
											</>
										))}
									</dl>
								</div>
							</>
						)
					}
					{
						tables && (
							<>
								<h2>速記表</h2>
								<div class="tables">
									<Fragment set:html={render(tables)} />
								</div>
							</>
						)
					}
					{
						pitfalls && (
							<>
								<h2>容易被電的點</h2>
								<div class="two">
									<Fragment set:html={render(pitfalls)} />
								</div>
							</>
						)
					}
				</div>
			</div>
			<footer>
				<span>htlin222.github.io/hema-board-interview-guide · 完整內容：/topics/{Astro.params.slug}/</span>
				<span>一頁速查 · 去名化整理，非官方資料</span>
			</footer>
		</div>

		<script is:inline>
			// 速查內容由主題頁自動抽取，長度會變。外框是固定的橫式 A4（跟手冊同一套），
			// 內容超出時把 .inner 等比例縮小到剛好塞進去；縮小後可用寬度變大會重新折行，所以量幾輪收斂。
			(function () {
				var box = document.querySelector('.sheet .content');
				var inner = box && box.querySelector('.inner');
				if (!inner) return;
				function fit() {
					inner.style.zoom = '1';
					var room = box.clientHeight - 10; // 多欄排版的高度量測會少算一點，留安全距離
					var h = inner.getBoundingClientRect().height; // 實際顯示高度（已含 zoom）
					if (h <= room) return;
					// 縮小後可用寬度變大、會少折幾行，所以用實際高度反覆逼近；最後一輪保證不超出
					var lo = 0.6, hi = 1;
					for (var i = 0; i < 10; i++) {
						var mid = (lo + hi) / 2;
						inner.style.zoom = String(mid);
						if (inner.getBoundingClientRect().height <= room) lo = mid;
						else hi = mid;
					}
					inner.style.zoom = String(Math.floor(lo * 1000) / 1000);
				}
				if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
				else window.addEventListener('load', fit);
			})();
		</script>
	</body>
</html>
