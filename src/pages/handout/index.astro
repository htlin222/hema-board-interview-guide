---
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
const topics = docs
	.filter((d) => d.id.startsWith('topics/') && !d.id.endsWith('exam-format-and-mindset'))
	.sort((a, b) => (a.data.sidebar?.order ?? 99) - (b.data.sidebar?.order ?? 99));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>一頁速查（可列印）｜血液科口試走向指南</title>
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<style>
			body {
				margin: 0;
				padding: 40px 20px 60px;
				background: #f6f4f9;
				color: #1f1b2a;
				font: 15px/1.6 'PingFang TC', 'Heiti TC', system-ui, sans-serif;
			}
			main {
				max-width: 640px;
				margin: 0 auto;
			}
			h1 {
				font-size: 24px;
				margin: 0 0 6px;
			}
			p.lead {
				margin: 0 0 26px;
				color: #57506b;
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
				border-top: 1px solid #ddd8e6;
			}
			li a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 12px;
				padding: 11px 4px;
				border-bottom: 1px solid #ddd8e6;
				color: inherit;
				text-decoration: none;
			}
			li a:hover {
				background: #efe9f8;
			}
			li a span.n {
				color: #7b6f95;
				font-size: 13px;
				white-space: nowrap;
			}
			nav {
				margin-top: 24px;
				font-size: 14px;
			}
			nav a {
				color: #6b3fa0;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>一頁速查（可列印）</h1>
			<p class="lead">
				每章一張 A4：推理架構、每題的破題關鍵句、速記表、容易被電的點。擬答與影片不印——需要細節時回網站看。
				開啟後按「列印 / 存成 PDF」即可。
			</p>
			<ul>
				{
					topics.map((t) => (
						<li>
							<a href={`${base}/handout/${t.id.replace('topics/', '')}/`}>
								<span>{t.data.title}</span>
								<span class="n">列印 →</span>
							</a>
						</li>
					))
				}
			</ul>
			<nav><a href={`${base}/`}>← 回網站</a></nav>
		</main>
	</body>
</html>
